# Name of this VPS in host-dashboard labels. Do not deploy the agent here.
SERVER_NAME=monitoring

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Basic auth for remote write. Use the same values on every agent.
# Password without quotes or YAML-significant characters: colon, hash, newline.
VMAUTH_USERNAME=agent
VMAUTH_PASSWORD=change-me
VICTORIAMETRICS_RETENTION_MONTHS=1

ALERTMANAGER_EMAIL_FROM=alerts@example.com
ALERTMANAGER_EMAIL_TO=you@example.com
ALERTMANAGER_EMAIL_SMARTHOST=smtp.example.com:587
ALERTMANAGER_EMAIL_AUTH_USERNAME=alerts@example.com
ALERTMANAGER_EMAIL_AUTH_PASSWORD=change-me
ALERTMANAGER_EMAIL_REQUIRE_TLS=true

GLITCHTIP_DOMAIN=https://glitchtip.ilialksv.ru
GLITCHTIP_SECRET_KEY=change-me-to-a-long-random-value
GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@example.com
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_ENABLE_ADMIN=false
GLITCHTIP_ENABLE_OPENAPI=false
GLITCHTIP_ENABLE_MCP=false
GLITCHTIP_ENABLE_DUCKDB=false
GLITCHTIP_POSTGRES_DB=glitchtip
GLITCHTIP_POSTGRES_USER=glitchtip
GLITCHTIP_POSTGRES_PASSWORD=change-me
GLITCHTIP_VALKEY_PASSWORD=change-me

# DbGate panel login. A long random password: this login opens every database.
DBGATE_LOGIN=admin
# Addresses or CIDRs, comma-separated, that may open db.ilialksv.ru at all
# (the VPN's exit IP). Everyone else gets 403 from Traefik.
DBGATE_ALLOWED_IPS=203.0.113.10
DBGATE_PASSWORD=change-me
# Private half of the db-tunnel key: base64 of the whole OpenSSH key file, one
# line, no \n. Agents hold the public half. Bash: base64 -w0 db-tunnel
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("db-tunnel"))
DB_TUNNEL_PRIVATE_KEY_BASE64=change-me

# Umami. Generate each secret with: openssl rand -hex 32
# PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { '{0:x2}' -f $_ })
UMAMI_APP_SECRET=change-me
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=change-me-64-hex-characters
UMAMI_POSTGRES_DB=umami
UMAMI_POSTGRES_USER=umami
UMAMI_POSTGRES_PASSWORD=change-me
# 1 opens the read-only MCP endpoint at umami.ilialksv.ru/mcp (API key auth); empty keeps it closed
UMAMI_MCP_ENABLED=
