# Unique server name. It becomes the server label on every series from this host.
SERVER_NAME=genario

# Full ingest URL. Basic auth matches VMAUTH_* on the central stack.
VMAGENT_REMOTE_WRITE_URL=https://ingest.ilialksv.ru/api/v1/write
VMAGENT_REMOTE_WRITE_USERNAME=agent
VMAGENT_REMOTE_WRITE_PASSWORD=change-me

# Public half of the DbGate tunnel key (one line, ssh-ed25519 ...). The same key
# on every server; the private half is DB_TUNNEL_PRIVATE_KEY_BASE64 on the
# central stack.
DB_TUNNEL_PUBLIC_KEY=ssh-ed25519 AAAA-change-me db-tunnel
DB_TUNNEL_PORT=2222
