VMAGENT_IMAGE=victoriametrics/vmagent:v1.143.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1

# Полный URL приёма. Basic auth совпадает с VMAUTH_* центрального стека.
VMAGENT_REMOTE_WRITE_URL=https://ingest.ilialksv.ru/api/v1/write
VMAGENT_REMOTE_WRITE_USERNAME=agent
VMAGENT_REMOTE_WRITE_PASSWORD=change-me

# Уникальное имя сервера. Попадёт в метку server у всех рядов с этого хоста.
SERVER_NAME=genario
